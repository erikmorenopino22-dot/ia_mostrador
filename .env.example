# Configuración de Mostrador. El lanzador crea un archivo .env a partir de este
# la primera vez; solo hace falta tocarlo para cambiar algo.

# ---------- IA propia ----------
# La IA de Mostrador se crea en este equipo a partir de un modelo abierto.
# Elige la base según el ordenador (ver GUIA_INSTALACION.md):
#   gemma3:4b   sin tarjeta gráfica o con 8 GB de RAM (más flojo)
#   gemma3:12b  tarjeta gráfica con 8-12 GB o un Mac con 16 GB (recomendado)
#   gemma3:27b  tarjeta gráfica con 24 GB (la mejor calidad)
# Si el centro entrena su propio modelo, pon aquí el nombre con el que lo cargó (ver ENTRENAR_IA.md).
IA_MODELO_BASE=gemma3:4b
IA_NOMBRE=mostrador
IA_CENTRO=CIPFP Ausiàs March (València)

# "local" para uso normal; "fake" solo para probar la aplicación sin IA.
LLM_PROVIDER=local
OLLAMA_URL=http://localhost:11434

# ---------- Servidor ----------
PUERTO=8000
DATABASE_URL=sqlite:///./mostrador.db
# Secreto para firmar las sesiones. El lanzador genera uno aleatorio.
SECRET_KEY=cambia-esto
TOKEN_HORAS=12
LIMITE_DIARIO_ALUMNO=150

# ---------- Copias de seguridad ----------
# Una copia al día de la base de datos en la carpeta "copias" (se conservan las 30 últimas).
# COPIAS_HORAS=0 las desactiva. Conviene que esa carpeta esté en otro disco o se copie fuera del equipo.
COPIAS_CARPETA=copias
COPIAS_HORAS=24
COPIAS_CONSERVAR=30
